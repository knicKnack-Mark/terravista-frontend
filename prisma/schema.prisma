
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingType {
  BUY
  RENT
}

enum PropertyStatus {
  ACTIVE
  PENDING
  SOLD
  RENTED
  INACTIVE
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Property {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  title       String
  location    String
  price       Decimal        @db.Decimal(14, 2)
  currency    String         @default("PHP")
  type        ListingType
  category    String
  bedrooms    Int            @default(0)
  bathrooms   Int            @default(0)
  area        String
  lotArea     String
  image       String
  gallery     String[]
  description String         @db.Text
  amenities   String[]
  featured    Boolean        @default(false)
  status      PropertyStatus @default(ACTIVE)
  inquiries   Inquiry[]
  viewings    ViewingAppointment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([type, status])
  @@index([featured])
  @@index([location])
}

model Inquiry {
  id          Int           @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  message     String?       @db.Text
  status      InquiryStatus @default(NEW)
  propertySlug String?
  property    Property?     @relation(fields: [propertySlug], references: [slug], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([propertySlug])
}

model ViewingAppointment {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  phone        String
  preferredDate DateTime
  preferredTime String
  message      String?       @db.Text
  status       ViewingStatus @default(REQUESTED)
  propertySlug String
  property     Property      @relation(fields: [propertySlug], references: [slug], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, preferredDate])
  @@index([propertySlug])
}
